  "model_selection_status": "Current GA GPT-5.4 nano/mini/full and embedding selections verified against France Central catalog/quota on 2026-10-29. No Legacy models. Chat allocations are sized for four teams sharing deployments at a 50000-TPM per-team gateway ceiling; judge allocation is separate for evaluations. Allocation is not reserved throughput or a spending cap. Live 50-unit chat deployments reported 50000 TPM/50 RPM; final allocations still require actual rate-limit readback and concurrent rehearsal. Native planning rejects non-GA or retired models/SKUs; genuine agent smoke/regression/provenance acceptance remains required.",
  "core_modules": ["M1", "M2", "M3", "M4", "M5"],
  "bonus_modules": ["B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8", "B9"],
  "approved_proposal_saving": "core",
  "publication": "separate-human-librarian-only",
  "semantic_cache": {
    "enabled_by_default": false,
    "requires_explicit_cost_review": true
  }
