<validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="A valid workload Entra token is required" require-expiration-time="true" require-signed-tokens="true" output-token-variable-name="labJwt">
  <openid-config url="https://login.microsoftonline.com/${tenant_id}/v2.0/.well-known/openid-configuration" />
  <audiences><audience>${client_id}</audience></audiences>
  <issuers><issuer>https://login.microsoftonline.com/${tenant_id}/v2.0</issuer></issuers>
</validate-jwt>
<set-variable name="labTeam" value="@{
    var jwt = (Jwt)context.Variables[&quot;labJwt&quot;];
    var roles = jwt.Claims.GetValueOrDefault(&quot;roles&quot;, new string[0]);
    var allowed = new string[] {${team_roles}};
    var teams = roles.Where(r => allowed.Contains(r)).ToArray();
    return teams.Length == 1 ? teams[0].Substring(5) : (teams.Length == 0 &amp;&amp; roles.Contains(&quot;Librarian&quot;) ? &quot;librarian&quot; : &quot;&quot;);
}" />
<choose>
  <when condition="@(((string)context.Variables[&quot;labTeam&quot;]).Length == 0)">
    <return-response><set-status code="403" reason="Exactly one workload team role or the human librarian role is required" /></return-response>
  </when>
</choose>
<set-header name="X-Team-Id" exists-action="override"><value>@((string)context.Variables["labTeam"])</value></set-header>
<set-header name="X-Publisher-Role" exists-action="override"><value>@(((Jwt)context.Variables["labJwt"]).Claims.GetValueOrDefault("roles", new string[0]).Contains("Librarian") ? "librarian" : "participant")</value></set-header>
<set-header name="X-Reviewer" exists-action="override"><value>@(((Jwt)context.Variables["labJwt"]).Claims.GetValueOrDefault("oid", new string[0]).FirstOrDefault())</value></set-header>
<set-header name="X-Gateway-Secret" exists-action="delete" />
<set-header name="api-key" exists-action="delete" />
<set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
