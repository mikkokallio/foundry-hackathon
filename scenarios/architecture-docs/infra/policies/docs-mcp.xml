<policies>
  <inbound>
    <base />
    ${auth}
    ${query_encoding}
    <rate-limit-by-key calls="${request_limit}" renewal-period="60" counter-key="@(context.Api.Id + &quot;:&quot; + (string)context.Variables[&quot;labTeam&quot;])" />
    ${json_body}
  </inbound>
  <backend><base /></backend>
  <outbound><base />${diagnostics}</outbound>
  <on-error><base />${diagnostics}</on-error>
</policies>
