<policies>
  <inbound>
    <base />
    ${auth}
    <choose>
      <when condition="@(context.Operation.Id == &quot;publishProposal&quot; &amp;&amp; context.Request.Headers.GetValueOrDefault(&quot;X-Publisher-Role&quot;, &quot;&quot;) != &quot;librarian&quot;)">
        <return-response><set-status code="403" reason="Publication requires the human librarian role" /></return-response>
      </when>
    </choose>
    <rate-limit-by-key calls="60" renewal-period="60" counter-key="@(context.Api.Id + &quot;:&quot; + (string)context.Variables[&quot;labTeam&quot;])" />
    <authentication-managed-identity resource="${audience}" />
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
